{
  "name": "paybox-kreopoly-lens",
  "version": "0.5.0",
  "description": "On-chain Polymarket intelligence + copy-trade signal detection for AI agents. 17 MCP tools.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts src/http.ts --bundle --platform=node --format=esm --target=node20 --outdir=dist",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/http.ts",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.12.2",
    "esbuild": "0.28.2",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
